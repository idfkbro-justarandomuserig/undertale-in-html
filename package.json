{
  "name": "resale-command-center",
  "version": "1.0.0",
  "description": "Local MCP server, web dashboard, and background daemon bridging a SQLite inventory/stock database to Claude Cowork / Claude Desktop and your phone.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/pc/mcp-server/index.js",
    "start:web": "node dist/web/server/index.js",
    "start:daemon": "node dist/pc/daemon/daemon.js",
    "install-daemon": "npm run build && node dist/pc/daemon/installer.js",
    "dev:mcp": "tsx pc/mcp-server/index.ts",
    "dev:web": "tsx web/server/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "better-sqlite3": "^11.9.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18"
  }
}
