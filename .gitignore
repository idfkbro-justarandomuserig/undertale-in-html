node_modules/
dist/

# Runtime data (generated locally, not shipped)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.json

# Secrets — never commit real credentials, only integrations.example.json
about-me/integrations.json

# Logs
logs/*.log

# Generated reports/exports
outputs/*.csv
outputs/*.json
!outputs/.gitkeep

# Daemon install artifacts (machine-specific, generated by npm run install-daemon)
start-daemon.bat

# Android build outputs (huge, machine/CI-generated; the APK comes from CI as an artifact)
phone/android/app/build/
phone/android/build/
phone/android/.gradle/
phone/android/local.properties

.env
